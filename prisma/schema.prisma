generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Starter models — replace with your own
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  username  String   @unique
  passwordHash String?
  avatar    String   @default("BB")
  bio       String?
  location  String?
  status String @default("ACTIVE")
  posts     Post[]
  sessions  Session[]
  following Follow[] @relation("UserFollowing")
  followers Follow[] @relation("UserFollowers")
  notifications Notification[]
  oauthAccounts OAuthAccount[]
  calendarEvents CalendarEvent[] @relation("CalendarEventCreator")
  aiSuggestions AiSuggestion[] @relation("AiSuggestionCreator")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Post {
  id        String   @id @default(cuid())
  authorId  String
  community String   @default("Bloom & Brew")
  content   String
  imageUrl  String?
  filter    String   @default("Natural")
  location  String?
  status String @default("VISIBLE")
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[]
  likes     Like[]
  savedBy   SavedPost[]
  shares    PostShare[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
}

model Comment {
  id             String   @id @default(cuid())
  postId         String
  authorName     String
  authorUsername String
  authorAvatar   String   @default("BB")
  text           String
  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([postId])
}

model Like {
  id             String   @id @default(cuid())
  postId         String
  userIdentifier String
  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([postId, userIdentifier])
  @@index([postId])
}

model SavedPost {
  id             String   @id @default(cuid())
  postId         String
  userIdentifier String
  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([postId, userIdentifier])
  @@index([postId])
}

model PostShare {
  id             String   @id @default(cuid())
  postId         String
  userIdentifier String
  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([postId, userIdentifier])
  @@index([postId])
}

model ExternalPost {
  id          String            @id
  source      String
  externalUrl String?
  title       String
  author      String
  community   String
  imageUrl    String?
  createdAt   DateTime
  comments    ExternalComment[]
  likes       ExternalLike[]
  savedBy     ExternalSavedPost[]
  shares      ExternalShare[]
  updatedAt   DateTime          @updatedAt

  @@index([source])
  @@index([createdAt])
}

model ExternalComment {
  id             String       @id @default(cuid())
  externalPostId String
  authorName     String
  authorUsername String
  authorAvatar   String       @default("BB")
  text           String
  post           ExternalPost @relation(fields: [externalPostId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([externalPostId])
}

model ExternalLike {
  id             String       @id @default(cuid())
  externalPostId String
  userIdentifier String
  post           ExternalPost @relation(fields: [externalPostId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([externalPostId, userIdentifier])
  @@index([externalPostId])
}

model ExternalSavedPost {
  id             String       @id @default(cuid())
  externalPostId String
  userIdentifier String
  post           ExternalPost @relation(fields: [externalPostId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([externalPostId, userIdentifier])
  @@index([externalPostId])
}

model ExternalShare {
  id             String       @id @default(cuid())
  externalPostId String
  userIdentifier String
  post           ExternalPost @relation(fields: [externalPostId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([externalPostId, userIdentifier])
  @@index([externalPostId])
}

model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  prompt      String?
  eventType   String   @default("CONTENT")
  status      String   @default("SCHEDULED")
  visibility  String   @default("PUBLIC")
  startsAt    DateTime
  endsAt      DateTime?
  createdById String?
  createdBy   User?    @relation("CalendarEventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startsAt])
  @@index([status])
  @@index([visibility])
  @@index([createdById])
}

model AiSuggestion {
  id              String   @id @default(cuid())
  title           String
  postIdea        String
  hashtags        String[] @default([])
  sourceTrend     String
  provider        String   @default("LOCAL")
  status          String   @default("PENDING")
  eventType       String   @default("CONTENT")
  calendarEventId String?
  createdById     String?
  createdBy       User?    @relation("AiSuggestionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([provider])
  @@index([sourceTrend])
  @@index([createdById])
}
