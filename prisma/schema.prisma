generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Starter models — replace with your own
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  username  String   @unique
  passwordHash String?
  avatar    String   @default("BB")
  bio       String?
  location  String?
  posts     Post[]
  sessions  Session[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Post {
  id        String   @id @default(cuid())
  authorId  String
  community String   @default("Bloom & Brew")
  content   String
  imageUrl  String?
  filter    String   @default("Natural")
  location  String?
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[]
  likes     Like[]
  savedBy   SavedPost[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
}

model Comment {
  id             String   @id @default(cuid())
  postId         String
  authorName     String
  authorUsername String
  authorAvatar   String   @default("BB")
  text           String
  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([postId])
}

model Like {
  id             String   @id @default(cuid())
  postId         String
  userIdentifier String
  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([postId, userIdentifier])
  @@index([postId])
}

model SavedPost {
  id             String   @id @default(cuid())
  postId         String
  userIdentifier String
  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([postId, userIdentifier])
  @@index([postId])
}
