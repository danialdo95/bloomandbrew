generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Starter models — replace with your own
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  username  String   @unique
  avatar    String   @default("BB")
  bio       String?
  location  String?
  posts     Post[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  authorId  String
  community String   @default("Bloom & Brew")
  content   String
  imageUrl  String?
  filter    String   @default("Natural")
  location  String?
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
}

model Comment {
  id             String   @id @default(cuid())
  postId         String
  authorName     String
  authorUsername String
  authorAvatar   String   @default("BB")
  text           String
  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([postId])
}
